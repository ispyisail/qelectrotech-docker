 		NumerotationContext nc = is_report
 				? project->reportAutoNum(current_autonum)
 				: project->elementAutoNum(current_autonum);
+
+			//Going arrows: fill the lowest free number instead of always
+			//incrementing, so deleting one gives its number back for reuse
+			//rather than leaving a permanent gap. Only meaningful for a
+			//plain numeric (unit/ten/hundred) counter part -- alphabetic and
+			//cyclic (wrap) parts keep their existing increment-only behavior.
+		if (is_report)
+		{
+			int numeric_index = -1;
+			for (int i = 0; i < nc.size(); ++i) {
+				const QString t = nc.itemAt(i).at(0);
+				if (t == QLatin1String("unit") || t == QLatin1String("ten") || t == QLatin1String("hundred")) {
+					numeric_index = i;
+					break;
+				}
+			}
+
+			if (numeric_index >= 0)
+			{
+				const QStringList numeric_item = nc.itemAt(numeric_index);
+				int increase = numeric_item.at(2).toInt();
+				if (increase <= 0)
+					increase = 1;
+
+				QSet<QString> used_labels;
+				ElementProvider ep(project);
+				for (const QPointer<Element> &other : ep.find(ElementData::NextReport))
+				{
+					if (other && other.data() != this && !other->actualLabel().isEmpty())
+						used_labels.insert(other->actualLabel());
+				}
+
+				NumerotationContext probe = nc;
+				int candidate = increase;
+				while (true)
+				{
+					probe.replaceValue(numeric_index, QString::number(candidate));
+					autonum::sequentialNumbers probe_seq;
+					autonum::setSequential(formula, probe_seq, probe, diagram(), current_autonum);
+					const QString probe_label = autonum::AssignVariables::formulaToLabel(formula, probe_seq, diagram(), this);
+					if (!used_labels.contains(probe_label))
+					{
+						nc.replaceValue(numeric_index, QString::number(candidate));
+						break;
+					}
+					candidate += increase;
+				}
+			}
+		}
+
 		NumerotationContextCommands ncc (nc);
 
 		m_autoNum_seq.clear();
